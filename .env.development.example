# Explicitly initialize a private .env via: python tools/api_env.py init
# Never upload your filled .env, ADC credentials or Codex authentication cache.
# Service preparation is separate from currently executable application adapters.
MIRA_PROFILE=development
MIRA_ENVIRONMENT=development
MIRA_PROVIDERS__GENERATION=mock
MIRA_PROVIDERS__REVIEW=fixture
MIRA_PROVIDERS__ALLOW_EXTERNAL_CALLS=false
MIRA_PROVIDERS__ALLOW_PAID_API=false

# Main text, image generation and actual-image review are separate capabilities.
# Choices: codex_native / gateway / openai_api. No automatic fallback.
MIRA_SERVICES__ROUTES__TEXT=codex_native
MIRA_SERVICES__ROUTES__IMAGE=codex_native
MIRA_SERVICES__ROUTES__VISION=codex_native
# Native Codex uses its supported login flow; NEVER copy auth.json into this file.
# Exact models are selected from your installed carrier / account, not guessed here.
MIRA_SERVICES__CODEX__TEXT_MODEL=gpt-6-luna
MIRA_SERVICES__CODEX__IMAGE_MODEL=
MIRA_SERVICES__CODEX__VISION_MODEL=

# Optional existing local gateway (application client credential, NOT Codex OAuth token).
# Endpoint is a suggested local convention; install/version and IC-01 still need checking.
MIRA_SERVICES__GATEWAY__BASE_URL=http://127.0.0.1:8317/v1
MIRA_SERVICES__GATEWAY__ACCESS_CONFIRMED=false
MIRA_SERVICES__GATEWAY__API_KEY=
MIRA_SERVICES__GATEWAY__TEXT_MODEL=
MIRA_SERVICES__GATEWAY__IMAGE_MODEL=
MIRA_SERVICES__GATEWAY__VISION_MODEL=

# Optional standard API fallback: secure setup in ChatGPT; leave blank if not using it.
# Presence of a key never grants inference, spending, or automatic route switching.
OPENAI_API_KEY=
MIRA_SERVICES__OPENAI__TEXT_MODEL=
MIRA_SERVICES__OPENAI__IMAGE_MODEL=
MIRA_SERVICES__OPENAI__VISION_MODEL=

# JEV/TypeSafe: separate service/key. /v1/systemone is not a chat-completions API.
TYPESAFE_API_KEY=
MIRA_SERVICES__JEV__MODEL=

# Google STT V2 + exact Gemini Enterprise 3.8 Flash TTS Preview.
# This is a provider decision, not proof that account/IAM/voice access is ready.
MIRA_SERVICES__SPEECH__ASR_PROVIDER=google_cloud
MIRA_SERVICES__SPEECH__TTS_PROVIDER=google_cloud
# Account/API enablement/IAM/region/voice and spend permission need real validation.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
MIRA_SERVICES__SPEECH__STT_LOCATION=us
MIRA_SERVICES__SPEECH__STT_MODEL=chirp_3
MIRA_SERVICES__SPEECH__STT_LANGUAGE_CODE=cmn-Hans-CN
MIRA_SERVICES__SPEECH__TTS_LANGUAGE_CODE=cmn-CN
MIRA_SERVICES__SPEECH__TTS_VOICE=Gacrux
MIRA_SERVICES__SPEECH__TTS_ENDPOINT=aiplatform.googleapis.com
MIRA_SERVICES__SPEECH__TTS_MODEL=gemini-3.8-flash-tts
MIRA_SERVICES__SPEECH__TTS_LOCATION=global
MIRA_SERVICES__SPEECH__TTS_STYLE=御姐音，语调轻快，爽朗自然，咬字清晰，亲切有活力，不刻意压低嗓音或拖慢语速。
# ADC stays with Google's supported credential chain, never inline JSON or committed files.

# Metadata only: explicit CLI flag AND this opt-in AND bounded request count are required.
# No inference probes are implemented in this helper; these are NOT spend limits.
MIRA_SERVICES__PROBE__ALLOW_METADATA=false
MIRA_SERVICES__PROBE__MAX_REQUESTS=0
MIRA_SERVICES__PROBE__TIMEOUT_SECONDS=5

# OBS-01: sanitized local logs. Development environment never implies raw consent.
MIRA_DIAGNOSTICS__ENABLED=true
MIRA_DIAGNOSTICS__DIRECTORY=var/diagnostics
MIRA_DIAGNOSTICS__DEVELOPMENT_RECORDING=false
MIRA_DIAGNOSTICS__RECORDING_CONSENT=false
