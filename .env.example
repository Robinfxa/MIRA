# Public first-use template: sh scripts/start copies it only if .env is absent.
# Existing .env files and their permissions are never changed by the launcher.
# Values do not grant data/billing permission: choose the local live preset first.
MIRA_PROFILE=mock
MIRA_ENVIRONMENT=development
MIRA_HTTP__HOST=127.0.0.1
MIRA_HTTP__PORT=8000
MIRA_HTTP__ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
MIRA_PROVIDERS__GENERATION=mock
MIRA_PROVIDERS__REVIEW=fixture
MIRA_PROVIDERS__MOCK_DELAY_MS=500
# MIRA_PROVIDERS__REPLAY_SCENARIO=photo-tour  # only when generation=replay
MIRA_PROVIDERS__ALLOW_EXTERNAL_CALLS=false
MIRA_PROVIDERS__ALLOW_PAID_API=false
# MIRA_PROVIDERS__API_KEY=  # reserved, never add a real value to tracked files
# This configuration alone remains mock. scripts/start explicitly selects the live
# subscription profile after local acceptance, using the unchanged live_provider.py.
# CLI preset: gpt-6.1-sol / Fast / voice + story + images / review gpt-6-luna.

# Public startup fields used only by scripts/start; explicit CLI options win.
# The core loader ignores this independent prefix. Do not rename it to MIRA_*.
# No authorization fields are accepted here: live data/use needs a local choice.
MIRAAPP_PROVIDER=chatgpt_subscription
MIRAAPP_MODEL=gpt-6.1-sol
MIRAAPP_SERVICE_TIER=fast
MIRAAPP_VOICE=true
MIRAAPP_STORY=true
MIRAAPP_STORY_IMAGES=true
MIRAAPP_IMAGE_REVIEW_MODEL=gpt-6-luna
MIRAAPP_ADC_FILE='${HOME}/.config/gcloud/application_default_credentials.json'
# Empty means the existing MIRA-owned default; never copy another app's session.
MIRAAPP_AUTH_STORE=

# Full API preparation template: .env.development.example (all live calls remain off).
# tools/api_env.py check reads only an explicitly selected .env; no auto authentication.

# OBS-01: sanitized local logs. Development environment never implies raw consent.
MIRA_DIAGNOSTICS__ENABLED=true
MIRA_DIAGNOSTICS__DIRECTORY=var/diagnostics
MIRA_DIAGNOSTICS__DEVELOPMENT_RECORDING=false
MIRA_DIAGNOSTICS__RECORDING_CONSENT=false

# Google voice: fill your own project locally; quota project is optional.
# No account, token, credential, ADC contents, API key or consent is distributed.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
MIRA_SERVICES__SPEECH__ASR_PROVIDER=google_cloud
MIRA_SERVICES__SPEECH__TTS_PROVIDER=google_cloud
MIRA_SERVICES__SPEECH__STT_LOCATION=us
MIRA_SERVICES__SPEECH__STT_MODEL=chirp_3
MIRA_SERVICES__SPEECH__STT_LANGUAGE_CODE=cmn-Hans-CN
MIRA_SERVICES__SPEECH__TTS_LANGUAGE_CODE=cmn-CN
MIRA_SERVICES__SPEECH__TTS_VOICE=Gacrux
MIRA_SERVICES__SPEECH__TTS_ENDPOINT=aiplatform.googleapis.com
MIRA_SERVICES__SPEECH__TTS_MODEL=gemini-3.8-flash-tts
MIRA_SERVICES__SPEECH__TTS_LOCATION=global
MIRA_SERVICES__SPEECH__TTS_STYLE='御姐音，语调轻快，爽朗自然，咬字清晰，亲切有活力，不刻意压低嗓音或拖慢语速。'
# Default ADC path belongs to the current user's HOME and is selected by scripts/start.
# Never source this file in a shell. The startup wrapper reads MIRAAPP_* fields;
# MIRA's existing loader reads the service fields.
